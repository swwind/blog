    "build:static": "vite build --ssr -c adapters/static/vite.config.ts",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "start": "node server.js",
    "start:static": "node server-static.js",
    "dev": "vite",
    "dev:pages": "wrangler pages dev"
  },
